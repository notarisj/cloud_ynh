# Generated by the YunoHost install script — do not edit by hand.
# Changes are overwritten on upgrade; use `yunohost app config` instead.

NODE_ENV=production
PORT=__PORT__
APP_ID=__APP__
APP_PATH=__PATH__
APP_PUBLIC_URL=https://__DOMAIN____PATH__

# ── Storage ──────────────────────────────────────────────
# users/<username> is each account's private root; shared/ is the common area.
DATA_DIR=__DATA_DIR__
ENABLE_SHARED=__ENABLE_SHARED__

# Per-user quota in bytes (0 = unlimited) and the single-file upload ceiling.
USER_QUOTA_BYTES=__USER_QUOTA_BYTES__
MAX_UPLOAD_BYTES=__MAX_UPLOAD_BYTES__

# ── Previews ─────────────────────────────────────────────
ENABLE_THUMBNAILS=__ENABLE_THUMBNAILS__
THUMBNAIL_CACHE_MB=512

# ── Authentication ───────────────────────────────────────
# Shared secret proving a request arrived through nginx and not directly on
# 127.0.0.1:__PORT__. Rotated on every install.
PROXY_SECRET=__PROXY_SECRET__

# Signing key for access and refresh tokens.
JWT_SECRET=__JWT_SECRET__
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# YunoHost LDAP — used to verify passwords sent by native clients and to check
# that the account still holds the app permission.
LDAP_URL=ldap://127.0.0.1:389
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=yunohost,dc=org
# Membership in either of these grants access. cloud.main is this app's own
# YunoHost permission, so revoking it in the admin panel logs devices out.
REQUIRED_PERMISSION=__APP__.main
ADMIN_GROUP=admins

# Failed logins allowed per IP per 15 minutes before requests are rejected.
LOGIN_RATE_LIMIT=10

[Unit]
Description=Cloud file storage API — __APP__
After=network.target slapd.service
Wants=slapd.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/server
Environment=NODE_ENV=production
EnvironmentFile=__INSTALL_DIR__/server/.env
ExecStart=__NODE__ __INSTALL_DIR__/server/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=__APP__

# Large directory listings and many concurrent range requests.
LimitNOFILE=65535

# ── Hardening ────────────────────────────────────────────
# The service only reads and writes user files; it never needs privileges.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict

# The users' files live at /home/yunohost.app/__APP__, which is inside the very
# tree ProtectHome= hides. "tmpfs" still replaces /home with an empty mount —
# so no other account's home is visible to this service — and BindPaths mounts
# just this app's data directory back in. Plain "ProtectHome=true" would leave
# the service unable to see its own storage, and it exits rather than serve
# from a directory that is not there.
ProtectHome=tmpfs
BindPaths=__DATA_DIR__

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=__DATA_DIR__ __INSTALL_DIR__/server
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
# SystemCallFilter is intentionally omitted: Node.js needs a broad syscall set
# and filtering it reliably breaks the runtime rather than hardening it.

[Install]
WantedBy=multi-user.target

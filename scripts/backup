#!/bin/bash
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

# install_dir is rebuilt from source on restore, but backing it up keeps the
# restore fast and offline-capable.
ynh_backup "$install_dir"

# The users' files. This is the part that actually matters.
ynh_backup "$data_dir"

ynh_print_info "Backup script completed for $app."

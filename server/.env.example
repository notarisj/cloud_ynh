# Local development. In production this file is generated by the YunoHost
# install script from conf/.env — see that template for the authoritative list.
NODE_ENV=development
PORT=3010
APP_ID=cloud
APP_PATH=/
APP_PUBLIC_URL=http://localhost:5173

DATA_DIR=./.devdata
# Sharing publishes an item from the owner's own files; nothing is ever moved
# into a common folder. ENABLE_SHARED is still read as an alias.
ENABLE_SHARING=true
USER_QUOTA_BYTES=0
MAX_UPLOAD_BYTES=21474836480

ENABLE_THUMBNAILS=true
THUMBNAIL_CACHE_MB=512

# Empty in dev: the proxy-secret check is skipped and requests are attributed
# to DEV_USER without touching LDAP.
PROXY_SECRET=
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

LDAP_URL=ldap://127.0.0.1:389
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=yunohost,dc=org
REQUIRED_PERMISSION=cloud.main
ADMIN_GROUP=admins
LOGIN_RATE_LIMIT=10

# Passkeys. In development the relying-party ID is derived from
# APP_PUBLIC_URL, which makes it "localhost" — the one host browsers allow
# WebAuthn on without HTTPS.
ENABLE_PASSKEYS=true
PASSKEY_RP_NAME=Cloud

# The identity every request is attributed to when NODE_ENV is not production,
# and whether it counts as an administrator.
DEV_USER=dev
DEV_ADMIN=true

# Local development. In production this file is generated by the YunoHost
# install script from conf/.env — see that template for the authoritative list.
NODE_ENV=development
PORT=3010
APP_ID=cloud
APP_PATH=/
APP_PUBLIC_URL=http://localhost:5173

DATA_DIR=./.devdata
ENABLE_SHARED=true
USER_QUOTA_BYTES=0
MAX_UPLOAD_BYTES=21474836480

ENABLE_THUMBNAILS=true
THUMBNAIL_CACHE_MB=512

# Empty in dev: the proxy-secret check is skipped and requests are attributed
# to DEV_USER without touching LDAP.
PROXY_SECRET=
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

LDAP_URL=ldap://127.0.0.1:389
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=yunohost,dc=org
REQUIRED_PERMISSION=cloud.main
ADMIN_GROUP=admins
LOGIN_RATE_LIMIT=10

DEV_USER=dev
